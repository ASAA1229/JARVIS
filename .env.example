# Copy this file to .env. Node.js 24 loads .env at startup; existing process
# environment variables take precedence over values in this file.

# Application listener. Optional; defaults to 3000. The server binds to 127.0.0.1.
PORT=3000

# Local runtime files. Optional; these defaults are already ignored by Git.
JARVIS_DEVICE_STATE_PATH=./data/devices.json
JARVIS_AUDIT_PATH=./data/audit.log

# Required to create owner-authorized device enrollment challenges.
# Generate a unique random value with: node scripts/configure-owner-token.mjs
# The placeholder is invalid and disables enrollment until replaced.
JARVIS_OWNER_CONTROL_TOKEN=REPLACE_WITH_A_RANDOM_SECRET

# Remembered approvals: after approving an app launch, allow the SAME app on the
# SAME enrolled device without asking again for this many minutes. Only app:launch
# is eligible; typing, file edits/deletes, terminal commands and other state changes
# still require fresh approval. Defaults to 30; use 0 to disable; maximum is 240.
JARVIS_REMEMBER_LAUNCH_MINUTES=30

# Optional local neural speech output (Piper). Configure BOTH values after installing
# Piper and downloading a compatible voice model. Leave both unset to use browser TTS.
# Use absolute paths; do not put secrets in this file.
JARVIS_PIPER_EXECUTABLE=
JARVIS_PIPER_MODEL=

# Primary local AI inference engine (native Ollama API).
# Install the model first: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
# Inference timeout in seconds (1-600); default 120.
OLLAMA_TIMEOUT=120

# Optional local embedding model for semantic personal-memory and document retrieval.
# Install separately if desired: ollama pull nomic-embed-text
JARVIS_EMBED_MODEL=nomic-embed-text

# Legacy compatibility only. Prefer OLLAMA_URL / OLLAMA_MODEL above.
# JARVIS_AI_BASE_URL=http://127.0.0.1:11434/v1
# JARVIS_AI_MODEL=llama3.2

# Personal AI gateway for your websites (portfolio and future sites).
# Set a port to enable an OpenAI-compatible /v1 API on its own listener; leave
# empty to keep it off. Create one key per site: npm run site-key -- create portfolio
# See docs/SITE_AI_GATEWAY.md before exposing it through a tunnel.
JARVIS_SITE_GATEWAY_PORT=
JARVIS_SITE_CLIENTS_PATH=./data/site-clients.json

# Optional cloud adapters are not used by first-party JARVIS conversations or agents;
# those remain pinned to local Ollama with no cloud fallback. The separate website
# gateway can use cloud only when explicitly enabled below. Cloud use may cost money.
JARVIS_CLOUD_OPENAI_API_KEY=
JARVIS_CLOUD_OPENAI_MODEL=
# JARVIS_CLOUD_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_CLOUD_ANTHROPIC_API_KEY=
JARVIS_CLOUD_ANTHROPIC_MODEL=
# JARVIS_CLOUD_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Website-gateway cloud task allowlist. Keep empty to disable all cloud routing.
# The first-party conversation and agent routes accept only native local Ollama.
JARVIS_CLOUD_ALLOWED_TASKS=
# Allow the website gateway to fall back to a cloud provider (default: local only).
JARVIS_SITE_GATEWAY_ALLOW_CLOUD=false

# ASAA ecosystem event producer (optional; disabled unless ALL THREE are set).
# Sends metadata-only events (task outcome kind, device-revoked category, audit-integrity failure)
# to ASAA. HTTPS is required unless the URL is loopback. Never commit real values.
# ASAA_EVENTS_URL=https://asaa.example.com
# ASAA_EVENTS_TOKEN=REPLACE_WITH_ASAA_INTEGRATION_TOKEN
# ASAA_ORG_ID=REPLACE_WITH_ASAA_ORG_ID

# Optional ecosystem manifest metadata (served at /.well-known/asaa-service).
# JARVIS_ENVIRONMENT=development
# JARVIS_BUILD_COMMIT=

# ASAA single sign-on for device enrollment (optional; enabled only when ISSUER and CLIENT_ID are set).
# OIDC Authorization Code + PKCE (S256) against the ASAA identity provider (local Keycloak). The
# redirect URI is http://127.0.0.1:<PORT>/auth/callback. The ID token must show authenticator-app MFA
# (amr contains otp or mfa) and the user must hold the required role. The owner-token path keeps working.
# JARVIS_OIDC_ISSUER=http://127.0.0.1:8280/realms/asaa
# JARVIS_OIDC_CLIENT_ID=jarvis-companion
# JARVIS_OIDC_REQUIRED_ROLE=jarvis-owner
# JARVIS_OIDC_REQUIRED_AMR=otp,mfa
# JARVIS_OIDC_ROLES_CLAIM=realm_access.roles
# JARVIS_OIDC_SCOPES=openid profile

# ASAA events via OAuth2 client credentials (optional; preferred over a static token).
# ASAA_EVENTS_URL, ASAA_ORG_ID and BOTH of ASAA_EVENTS_TOKEN_URL and ASAA_EVENTS_CLIENT_SECRET enable it. If
# ASAA_EVENTS_TOKEN is also set it is ignored (a warning is logged). A partial set disables the producer.
# The token URL must be https unless loopback. The secret is read from the environment only and is never
# logged, written to disk or sent in event bodies. Never commit real values.
# ASAA_EVENTS_TOKEN_URL=http://127.0.0.1:8280/realms/asaa/protocol/openid-connect/token
# ASAA_EVENTS_CLIENT_ID=jarvis-events
# ASAA_EVENTS_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
