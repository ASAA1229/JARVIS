{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jarvis/nexus-artifact-set.schema.json",
  "title": "JARVIS Nexus Artifact Set Publication Record",
  "description": "Logical inventory of files belonging to one release coordinate. Repository-specific paths and identity values are supplied only after the Nexus/ACI POC confirms them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseCoordinate", "publicationState", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customerId", "product", "version"],
      "properties": {
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "product": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "releaseId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "publicationState": { "enum": ["staged", "complete"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "fileName", "sha256", "size"],
        "properties": {
          "role": {
            "enum": ["package", "package_checksum", "release_manifest", "manifest_ignore", "manifest_ignore_checksum", "manifest_ignore_signature"]
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?!\\.\\.?$)[^/\\\\]+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string", "maxLength": 128 }
        }
      }
    }
  }
}