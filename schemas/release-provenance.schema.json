{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jarvis/release-provenance.schema.json",
  "title": "JARVIS Release Provenance Input",
  "description": "Build metadata contract. Replace example.invalid with an approved schema host before external publication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "source", "customer", "release", "artifact"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCommit", "buildNumber", "pipeline", "job"],
      "properties": {
        "gitCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40,64}$" },
        "buildNumber": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pipeline": { "type": "string", "minLength": 1, "maxLength": 128 },
        "job": { "type": "string", "minLength": 1, "maxLength": 256 },
        "branch": { "type": "string", "maxLength": 256 }
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customerId"],
      "properties": {
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "environment": { "type": "string", "maxLength": 128 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version"],
      "properties": {
        "product": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "releaseId": { "type": "string", "maxLength": 128 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256", "size"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "repository": { "type": "string", "maxLength": 256 },
        "repositoryPath": { "type": "string", "maxLength": 1024 }
      }
    }
  }
}
